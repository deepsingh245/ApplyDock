{
  "manifest_version": 3,
  "name": "ApplyDock",
  "version": "0.9.0",
  "minimum_chrome_version": "116",
  "description": "Manually capture selected jobs and hiring posts to a local queue and Notion, and prepare WhatsApp outreach in your own WhatsApp Web.",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://*.linkedin.com/*",
    "https://web.whatsapp.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Applications sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}